{
  "name": "nooblyjs-accelerator-infrastructure",
  "version": "0.2.0",
  "description": "Noobly Cloud: a NooblyJS accelerator (screens and API at /infrastructure) to launch and manage Linux VMs, apps from Git, databases and buckets on GCP and AWS.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./host": "./src/host/standalone.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "seed": "node --env-file-if-exists=.env server.js --seed",
    "test": "npm run test:express5 && npm run test:express4",
    "test:express5": "node --test --test-timeout=20000 \"test/**/*.test.js\"",
    "test:express4": "node --env-file=test/express4.env --test --test-timeout=20000 \"test/**/*.test.js\""
  },
  "dependencies": {
    "nooblyjs-core": "file:../../nooblyjs-core",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "express": "^5.2.1",
    "express4": "npm:express@^4.21.2",
    "linkedom": "^0.18.13"
  }
}
