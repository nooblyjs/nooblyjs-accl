# Standalone mode only (npm start). When a launcher loads this accelerator, the launcher's environment applies.
PORT=11008
# Where the standalone server keeps its files (this accelerator's are in <DATA_DIR>/infrastructure).
DATA_DIR=./data
# The clouds this install may use: mock, gcp, aws (comma-separated). Only mock exists until roadmap phase 2.
INFRA_PROVIDERS=mock
# Encrypts cloud credentials and passwords. Required in production; in development one is made in secrets/dev-key.txt.
# INFRA_SECRET_KEY=
# How long one unit of mock cloud work takes, in milliseconds (a network takes 2 units, a VM 3).
INFRA_MOCK_STEP_MS=1200
# How often to check which background jobs (account check, inventory sync) are due, in milliseconds.
INFRA_SYNC_CHECK_MS=60000
