{
  "name": "nooblyjs-accel-customers",
  "version": "0.3.0",
  "description": "NooblyJS accelerator for customer data management, marketing communications and contact-centre customer service",
  "main": "index.js",
  "files": [
    "index.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node test/app/index.js",
    "dev": "node --watch-path=src --watch-path=index.js test/app/index.js",
    "test": "jest",
    "coverage": "jest --coverage",
    "kill": "kill -9 $(lsof -t -i:3003)"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "peerDependencies": {
    "nooblyjs-core": ">=1.0.10"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nooblyjs-core": "../nooblyjs-core/",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "detectOpenHandles": true,
    "coverageDirectory": "<rootDir>/.temp/coverage",
    "collectCoverageFrom": [
      "index.js",
      "src/**/*.js",
      "!src/*/views/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "branches": 70
      },
      "./src/shared/repository/": {
        "lines": 90,
        "statements": 90
      }
    }
  },
  "author": "NooblyJS Team",
  "license": "ISC"
}
